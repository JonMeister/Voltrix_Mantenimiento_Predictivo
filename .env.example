# =============================================================================
# Variables de entorno — Voltrix Energy · Mantenimiento Predictivo (Equipo 6)
# Copiar este archivo como ".env" y completar valores reales (NO subir .env).
# =============================================================================

# --- Servidor HTTP ---
API_PORT=8080
SERVICE_VERSION=1.0.0
LOG_LEVEL=info

# --- Control de concurrencia y paralelismo ---
# En EC2 (t3.small, 2 vCPU / 2 GiB RAM) se recomienda MAX_CONCURRENT_JOBS=2 y DEFAULT_WORKERS=2
MAX_CONCURRENT_JOBS=2
DEFAULT_WORKERS=2
RETRY_AFTER_SECONDS=2

# --- Fuente de datos upstream ---
# "mock": datos de ejemplo determinísticos (Avance 1, sin requerir otras células)
# "http": llamadas HTTP reales contra las URLs inyectadas abajo (Avance 2 / Final)
DATA_SOURCE=mock
UPSTREAM_TIMEOUT_SECONDS=3

# --- URLs de servicios upstream (inyectadas por configuración, nunca en código) ---
# Consultar las direcciones vigentes en la hoja compartida Coordinacion_Voltrix
URL_INVENTARIO=http://localhost:8081
URL_ALERTAS=http://localhost:8083
URL_REPORTES=http://localhost:8084
URL_PRONOSTICOS=http://localhost:8000

# --- Base de datos PostgreSQL (contenedor privado en red interna) ---
POSTGRES_DB=voltrix_mantenimiento
POSTGRES_USER=voltrix_user
POSTGRES_PASSWORD=CAMBIAR_ESTE_PASSWORD_SEGURO
DATABASE_URL=postgres://voltrix_user:CAMBIAR_ESTE_PASSWORD_SEGURO@db:5432/voltrix_mantenimiento?sslmode=disable

# --- Semilla inicial de datos de ejemplo (Avance 1) ---
SEED_DEMO_DATA=true

